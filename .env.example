NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 이메일 발송 — 비밀번호 찾기 인증번호 / 관리자 임시비번 안내용.
# 우선순위: Gmail SMTP(GMAIL_*) → Resend(RESEND_API_KEY) → 없으면 발송 생략(no-op).
#
# [권장·무료] Gmail SMTP: 도메인 불필요, 임의 수신자에게 발송(하루 ~500통).
#   Google 계정 2단계 인증 → 앱 비밀번호(16자리) 발급해서 GMAIL_APP_PASSWORD 에.
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# [선택] Resend: 월 3,000통 무료지만 EMAIL_FROM 이 인증된 도메인이어야 임의 수신자 발송 가능.
RESEND_API_KEY=
EMAIL_FROM=

# ── AI(헬쑤쌤·자세·식단 사진·체성분·기구 인식) ──────────────────────────────
# 하나만 있으면 된다. 키가 있는 것 중 **위에서부터** 고른다(src/features/coach/ai.ts).
# 어느 것을 쓰든 화면 동작은 같다. Vercel 프로젝트 환경변수에도 넣어야 배포에서 동작.
#
# [권장·무료] Google Gemini: aistudio.google.com 에서 카드 없이 발급.
#   무료 티어가 비전을 그대로 주고 한국어가 낫다. 이미지를 여러 장 보낼 수 있다.
#   모델별로 분당·일일 요청 한도가 있다(초과하면 429 → 화면에 안내가 뜬다).
GEMINI_API_KEY=
# 기본 gemini-2.5-flash. 한도가 더 넉넉한 모델로 바꾸고 싶을 때만.
GEMINI_MODEL=
#
# [무료] NVIDIA NIM(Llama 3.2 Vision): build.nvidia.com 에서 발급. 개발·평가용(분당 40요청).
#   ⚠ 요청당 이미지 1장에 맞춰져 있다 — 자세 분석이 프레임 4장을 격자 한 장으로 합쳐 보낸다.
NVIDIA_API_KEY=
NVIDIA_MODEL=
#
# [유료·폴백] Anthropic Claude: console.anthropic.com 에서 발급.
#   위 둘이 다 없을 때만 쓰인다. 모델은 claude-haiku-4-5(사진 1장당 대략 수 원).
ANTHROPIC_API_KEY=

# ── 식약처 식품영양성분 DB (식단 검색 보조 출처) ──────────────────────────────
# 둘 다 비어 있으면 지금과 동일하게 정적 카탈로그 + custom_foods 로만 검색된다(기능 꺼짐).
#
# 왜 붙였나: 편의점 도시락·가공식품처럼 제품마다 값이 다른 음식을 지금은 사용자가 AI
# 사진분석으로 찍는다 — 우리가 돈을 내고 월 한도를 한 칸 먹는 일인데, 그런 제품은 이미
# 공표된 정답이 있다. 한 번 찾은 음식은 custom_foods 에 쌓여 다음부턴 API 를 안 부른다.
#
# 🔴 주소를 코드에 박지 않았다. 2026-09-07 실측 기준 인터넷에 흔히 도는 주소는 전부 죽었다:
#   식품안전나라 I2790·I0750 → ERROR-310(서비스 없음)
#   data.go.kr FoodNtrIrdntInfoService1 → NO_OPENAPI_SERVICE_ERROR(폐기)
# 살아 있는 것은 data.go.kr '전국통합식품영양성분정보 표준데이터' 인데, 표준데이터 주소에는
# 신청자마다 다른 uddi 가 들어가서 **활용신청을 해야 주소를 알 수 있다.**
#
# 받는 법: www.data.go.kr 에서 '전국통합식품영양성분정보' 검색 → 활용신청(즉시 승인) →
# '참고문서'/미리보기에 나오는 **요청 주소를 그대로** 아래에 붙이고, 인증키 자리를 {key},
# 검색어 자리를 {query} 로 바꾼다. (필요하면 개수 자리를 {rows} 로.)
#
# 예) 표준데이터(odcloud):
#   FOOD_DB_URL=https://api.odcloud.kr/api/15100070/v1/uddi:여기가신청마다다름?serviceKey={key}&page=1&perPage={rows}&cond[식품명::LIKE]={query}
# 예) 식품안전나라 계열 주소를 받았다면:
#   FOOD_DB_URL=https://openapi.foodsafetykorea.go.kr/api/{key}/서비스ID/json/1/{rows}/DESC_KOR={query}
# 두 포털의 응답 형식은 코드가 **둘 다** 읽는다(src/features/diet/food-db.ts).
FOOD_DB_URL=
FOOD_DB_API_KEY=
