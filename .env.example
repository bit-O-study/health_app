NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 이메일 발송 — 비밀번호 찾기 인증번호 / 관리자 임시비번 안내용.
# 우선순위: Gmail SMTP(GMAIL_*) → Resend(RESEND_API_KEY) → 없으면 발송 생략(no-op).
#
# [권장·무료] Gmail SMTP: 도메인 불필요, 임의 수신자에게 발송(하루 ~500통).
#   Google 계정 2단계 인증 → 앱 비밀번호(16자리) 발급해서 GMAIL_APP_PASSWORD 에.
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# [선택] Resend: 월 3,000통 무료지만 EMAIL_FROM 이 인증된 도메인이어야 임의 수신자 발송 가능.
RESEND_API_KEY=
EMAIL_FROM=

# 기구 사진 분석(디버그 기능 "equipment-scan") — Claude 비전으로 기구 식별 + 가능한 운동 추천.
# console.anthropic.com 에서 발급. 없으면 기능이 친절한 안내와 함께 비활성.
# 모델은 claude-haiku-4-5 (사진 1장당 대략 수 원). Vercel 프로젝트 환경변수에도 넣어야 배포에서 동작.
ANTHROPIC_API_KEY=
