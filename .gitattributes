# 셸 스크립트는 항상 LF — Windows(CRLF)로 체크아웃되면 bash 가 깨진다.
*.sh text eol=lf
gradlew text eol=lf

# Preserve byte-exact render inputs and verification SHA values across platforms.
tools/media/motion-refresh/skinned-3d/** -text whitespace=cr-at-eol

# Preserve imported exercise render provenance and SHA-256 evidence.
tools/media/imports/** -text whitespace=cr-at-eol
tools/media/motion-guides/** -text whitespace=cr-at-eol
