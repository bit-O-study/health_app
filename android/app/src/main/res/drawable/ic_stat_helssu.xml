<?xml version="1.0" encoding="utf-8"?>
<!--
  상태표시줄 알림의 작은 아이콘 — 헬쑤 마크(ㅎ + 바벨)의 흰색 단색판.
  안드로이드는 이 아이콘의 투명도(알파)만 쓰고 색은 알림 강조색(notification_accent)으로 칠한다.
  그래서 색 있는 로고를 그대로 쓰면 흰 네모로 보이고, 지정이 없으면 시스템이 동그라미 안에 "i" 가 있는
  기본 아이콘으로 바꿔 버린다. 도형은 src/features/brand/mark.tsx 의 HelssuMark 와 같은 좌표(100×100)다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <!-- 위쪽 짧은 막대 -->
    <path
        android:pathData="M43,17 L57,17"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
    <!-- 바벨 막대 -->
    <path
        android:pathData="M17,35 L83,35"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
    <!-- 왼쪽 원판 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M26,25 h2 a3,3 0 0 1 3,3 v14 a3,3 0 0 1 -3,3 h-2 a3,3 0 0 1 -3,-3 v-14 a3,3 0 0 1 3,-3 z" />
    <!-- 오른쪽 원판 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M72,25 h2 a3,3 0 0 1 3,3 v14 a3,3 0 0 1 -3,3 h-2 a3,3 0 0 1 -3,-3 v-14 a3,3 0 0 1 3,-3 z" />
    <!-- 아래 고리(ㅎ 의 동그라미) -->
    <path
        android:pathData="M33,67 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8" />
</vector>
